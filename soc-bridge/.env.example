# Modèle de configuration : copier en .env et renseigner les vraies valeurs
# Le fichier .env contient un mot de passe en clair : il est exclu du dépôt (.gitignore)

# Wazuh Indexer - port 9200, utilisateur "admin" de l'indexer
# (celui généré par wazuh-passwords-tool.sh -a, PAS le compte API manager 55000)
WAZUH_INDEXER_URL=https://192.168.1.XXX:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=change-me

# Ollama (conteneur Docker sur le PC d'inférence)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Filtrage : niveau de sévérité Wazuh minimum à traiter (3-15)
MIN_ALERT_LEVEL=7

# Nombre max d'alertes récupérées par passage
ALERTS_PER_BATCH=20

# Intervalle entre deux passages en mode --loop (secondes)
POLL_INTERVAL_SECONDS=60

# Chemin de la base SQLite locale
DB_PATH=./data/soc_bridge.db
